{
  "name": "@withinmeans/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/harness.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p .",
    "migrate": "tsx src/cli/migrate.ts",
    "conformance": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1175.0",
    "@aws-sdk/credential-providers": "^3.1175.0",
    "@aws-sdk/dsql-signer": "^3.1175.0",
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
    "@withinmeans/domain": "workspace:*",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15"
  }
}
