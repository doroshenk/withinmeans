{
  "name": "withinmeans",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @withinmeans/web dev",
    "test": "vitest run",
    "coverage": "pnpm -r --if-present coverage",
    "lint": "eslint . && prettier --check . && depcruise packages --config .dependency-cruiser.cjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tooling && tsc -p e2e",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "migrate": "pnpm --filter @withinmeans/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@trpc/server": "^11.29.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
